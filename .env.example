# Map: no keys needed. The basemap is MapLibre + free CARTO tiles.
# Only set this if you switch kepler to a Mapbox style.
# VITE_MAPBOX_TOKEN=

# Optional AI fallback for the "Ask City Pulse" chat (api/ask.ts, runs on Vercel only, uses Groq).
# Set it in Vercel > Project > Settings > Environment Variables, never in code or in the browser.
# Without it, the chat still works using its offline brain.
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b   # optional: tried in order when one is busy
